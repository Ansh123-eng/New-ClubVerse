<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Club Verse - Baars</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" type="text/css"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
  <link rel="stylesheet" href="/styles/dashbar.css">
  <link rel="stylesheet" href="/styles/bar.css">
  <style>
    .nav {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      padding: 5px 20px;
      background: rgba(0, 0, 0, 0);
      backdrop-filter: none;
      border-bottom: none;
      transition: all 0.3s ease;
    }
    #footer-club-logo{
      margin-left: 3%;
    }

    .nav.scrolled {
      background: rgba(30, 30, 30, 0.55);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      box-shadow: 0 2px 16px #232a3b40;
      border-bottom: none;
    }

    .banner-section {
      position: relative;
    }

    .banner-image {
      position: relative;
    }

    .banner-image img {
      width: 100%;
      height: 45vh;
      object-fit: cover;
      border-radius: 18px;
      box-shadow: 0 8px 32px #d4af37a0;
      display: block;
      z-index: 0;
    }

    .banner-image::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0.5, 0.9, 0.5, 0.3);
      z-index: 2;
    }

    .banner-shadow {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 45vh;
      border-radius: 18px;
      pointer-events: none;
      background: linear-gradient(to bottom, rgba(30, 30, 30, 0.7) 0%, rgba(30, 30, 30, 0.15) 40%, rgba(30, 30, 30, 0) 100%);
      z-index: 2;
    }

    .banner-content {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      width: 100%;
    }

    .banner-content h1 {
      color: honeydew;
      font-size: 70px;
      font-weight: 700;
      text-shadow: 2px 2px 8px #232a3b, 0 0 12px #d4af37;
      margin-bottom: 12px;
    }

    .banner-content h2 {
      color: #ffe100;
      font-size: 40px;
      font-weight: 600;
      text-shadow: 1.5px 1.5px #232a3b;
    }

    .section-title {
      text-align: center;
      margin-bottom: 80px;
      position: relative;
      z-index: 2;
      font-family: 'Playfair Display', serif;
      font-size: 3.5rem;
      color: #fff;
      margin-bottom: 20px;
      text-shadow: 0 0 20px rgba(212, 175, 55, 0.5), 0 0 40px rgba(212, 175, 55, 0.3);
      animation: titleGlow 2s ease-in-out infinite alternate;
    }

    @keyframes titleGlow {
      from {
        text-shadow: 0 0 20px rgba(212, 175, 55, 0.5), 0 0 40px rgba(212, 175, 55, 0.3);
      }
      to {
        text-shadow: 0 0 30px rgba(212, 175, 55, 0.8), 0 0 60px rgba(212, 175, 55, 0.5);
      }
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: -15px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 3px;
      background: linear-gradient(45deg, #d4af37, #ffd700);
      box-shadow: 0 0 10px rgba(212, 175, 55, 0.6);
    }

    .city-section {
      padding: 70px 5%;
      background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);
      max-width: none;
      margin: 0;
      position: relative;
    }

    .city-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 20% 20%, rgba(212, 175, 55, 0.05) 0%, transparent 50%),
                  radial-gradient(circle at 80% 80%, rgba(212, 175, 55, 0.05) 0%, transparent 50%);
      pointer-events: none;
    }

    .outlets-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 30px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .outlet-card {
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-radius: 25px;
      overflow: hidden;
      position: relative;
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.15);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(212, 175, 55, 0.1);
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
      transform: translateY(30px);
    }

    .outlet-card:nth-child(1) { animation-delay: 0.1s; }
    .outlet-card:nth-child(2) { animation-delay: 0.2s; }
    .outlet-card:nth-child(3) { animation-delay: 0.3s; }
    .outlet-card:nth-child(4) { animation-delay: 0.4s; }
    .outlet-card:nth-child(5) { animation-delay: 0.5s; }
    .outlet-card:nth-child(6) { animation-delay: 0.6s; }

    @keyframes fadeInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .outlet-card:hover {
      transform: translateY(-10px) scale(1.02);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), 0 0 30px rgba(212, 175, 55, 0.3);
      border-color: rgba(212, 175, 55, 0.3);
    }

    .outlet-img {
      height: 250px;
      overflow: hidden;
      position: relative;
    }

    .outlet-img::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(45deg, rgba(212, 175, 55, 0.2), rgba(255, 215, 0, 0.1));
      mix-blend-mode: overlay;
      z-index: 1;
      transition: opacity 0.5s ease;
      opacity: 0.7;
    }



    .outlet-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      filter: brightness(0.9) contrast(1.1);
    }

    .outlet-card:hover .outlet-img img {
      transform: scale(1.15);
      filter: brightness(1.1) contrast(1.2);
    }

    .outlet-info {
      padding: 30px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .outlet-info h3 {
      color: #d4af37;
      font-size: 1.5rem;
      margin-bottom: 10px;
      font-family: 'Playfair Display', serif;
    }

    .outlet-actions {
      margin-top: 20px;
      display: flex;
      gap: 15px;
      justify-content: center;
    }

    .outlet-btn {
      background: linear-gradient(45deg, #d4af37, #ffd700);
      color: #000;
      border-radius: 20px;
      padding: 10px 20px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      border: 2px solid transparent;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
      position: relative;
      overflow: hidden;
    }

    .outlet-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.5s;
    }

    .outlet-btn:hover::before {
      left: 100%;
    }

    .outlet-btn:hover {
      background: linear-gradient(45deg, #ffd700, #d4af37);
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(212, 175, 55, 0.5);
    }
  </style>
</head>

